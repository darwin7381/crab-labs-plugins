#!/bin/sh
# pre-push canary guard — install via tools/install-hooks.sh
# Blocks a push if any canary marker (tools/canaries.txt) is missing from the
# ref being pushed. Prevents stale-working-copy commits from silently reverting
# sibling features (the 2026-08-11 no_reply clobber class).
repo_root=$(git rev-parse --show-toplevel)
canaries="$repo_root/tools/canaries.txt"
[ -f "$canaries" ] || exit 0
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    file="${line%%::*}"; marker="${line#*::}"
    if ! git cat-file -e "$local_sha:$file" 2>/dev/null; then
      echo "⛔ pre-push canary FAILED: canary file $file MISSING at $local_sha" >&2
      fail=1
    elif ! git show "$local_sha:$file" | grep -qF "$marker"; then
      echo "⛔ pre-push canary FAILED: '$marker' missing from $file at $local_sha" >&2
      echo "   A commit from a stale working copy may have reverted a sibling feature." >&2
      fail=1
    fi
  done < "$canaries"
done
exit $fail
