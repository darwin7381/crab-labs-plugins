#!/bin/zsh
# Channel-bot wrapper — reference implementation
# Place at: ~/path/to/your/workspace/scripts/restore-channel-bot.sh
# Make executable: chmod +x restore-channel-bot.sh
#
# Purpose: keep a single long-running claude TUI alive inside a tmux session,
# wired up to the telegram-http (and optionally discord-http) MCP daemons via
# the --channels flag. When the TUI exits (e.g. user types /exit, channel-bot
# calls /restart, or claude crashes), this wrapper relaunches it.
#
# Critical capability for the channel-bot TUI control plane (telegram-http
# 1.1.0+): on each restart, this script reads ${NEXT_ARGS_FILE} and appends
# its contents (typically `--resume <session-id>`) to the claude command,
# letting the daemon force claude TUI to resume a specific session.
# (Note: 1.2.0+ usually inline-switches via /resume picker without a restart,
# but this mechanism stays as fallback for /restart and SSH-driven recovery.)
#
# Customise the four ALL_CAPS blocks below for your environment.

set +e  # explicit error handling; do not exit on grep no-match etc.

# ─── 1. ENVIRONMENT ────────────────────────────────────────────────────────
export HOME="/Users/USERNAME"
export PATH="$HOME/.bun/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# ─── 2. MANIFEST (SINGLE SOURCE OF TRUTH) ──────────────────────────────────
# All agent config (tmux session, workspace dir, full claude command, ports)
# lives in this .cc-agent.json manifest. Same file is consumed by:
#   - this wrapper (reads to start claude)
#   - supervisor.sh (reads to restart if applicable)
#   - dashboard web-ui (reads to display + restart button)
# Change in ONE place — all paths sync. See Obsidian:
#   System Operation/Claude Code Global Config/Agent Manifest as Single Source of Truth.md
MANIFEST="$HOME/path/to/your/workspace/.cc-agent.json"

if [ ! -f "$MANIFEST" ]; then
  echo "FATAL: manifest not found at $MANIFEST" >&2
  exit 1
fi

SESSION=$(jq -r '.tmux_session' "$MANIFEST")
WORKDIR=$(jq -r '.workspace_dir' "$MANIFEST")
CLAUDE_CMD_BASE=$(jq -r '.claude_command' "$MANIFEST")
TELEGRAM_HTTP_PORT=$(jq -r '.channels.telegram.http_port // "17631"' "$MANIFEST")
DISCORD_HTTP_PORT=$(jq -r '.channels.discord.http_port // "17641"' "$MANIFEST")

# Sanity check — the wrapper depends on these three fields being present.
for required in SESSION WORKDIR CLAUDE_CMD_BASE; do
  if [ -z "${(P)required}" ] || [ "${(P)required}" = "null" ]; then
    echo "FATAL: $required missing or null in manifest $MANIFEST" >&2
    exit 1
  fi
done

# Notes on what `claude_command` MUST contain (verified at boot above — we
# don't second-guess):
#   - Full path to a pinned claude binary (NOT bare `claude`, which auto-updates)
#     e.g.  /Users/USERNAME/.local/share/claude-pinned/2.1.140
#     2.1.141~2.1.148 have a silent HTTP MCP transport regression (GitHub #21721)
#   - All --channels flags for plugin loading (telegram-http + discord-http)
#   - --disallowedTools AskUserQuestion ExitPlanMode (required for channel-bot;
#     these picker tools deadlock without keyboard access — see upstream #40644)
#   - --dangerously-skip-permissions
# DO NOT add env vars (DISABLE_AUTOUPDATER, *_HTTP_PORT) here — they're added
# at exec time below so the same value gets used by claude's .mcp.json subst.

# ─── 3. RESUME ARGS OVERRIDE (1.1.0+ TUI control plane) ────────────────────
# Restart-resume policy: DEFAULT to `claude --continue` so EVERY restart
# (crash / launchd / /restart) auto-resumes the most recent session in
# $WORKDIR — no session-id capture, no picker, no context loss. `--continue`
# needs no id/search. Two overrides:
#   * NEXT_ARGS_FILE (`/tmp/channel-bot-next-args`): explicit args (typically
#     `--resume <id>` to land on a SPECIFIC, non-most-recent session). The
#     daemon's /restart and 1.1.0-style /resume write here. Wins over --continue.
#     Path MUST match the daemon plist's CHANNEL_BOT_NEXT_ARGS_FILE env var.
#   * FRESH_SENTINEL (`/tmp/channel-bot-fresh`): start a brand-new empty session
#     on purpose (a "/new"). Suppresses --continue for that one start.
# NOTE: a wrapper that defaults to NEITHER --continue nor --resume opens a FRESH
# empty session on every crash → silent context loss. Always default --continue.
NEXT_ARGS_FILE="/tmp/channel-bot-next-args"
FRESH_SENTINEL="/tmp/channel-bot-fresh"

build_claude_cmd() {
  local extra=""
  local resume="--continue"   # default: resume most recent session in $WORKDIR
  if [ -f "$NEXT_ARGS_FILE" ]; then
    extra=$(<"$NEXT_ARGS_FILE")
    extra="${extra//$'\n'/ }"  # collapse newlines to spaces
    log "found $NEXT_ARGS_FILE → explicit args (override --continue): $extra"
    mv "$NEXT_ARGS_FILE" "$NEXT_ARGS_FILE.used.$(date +%s)" 2>/dev/null || rm -f "$NEXT_ARGS_FILE"
    resume=""   # explicit args (e.g. --resume <id>) replace the default --continue
  elif [ -f "$FRESH_SENTINEL" ]; then
    log "found $FRESH_SENTINEL → FRESH session (suppress --continue)"
    rm -f "$FRESH_SENTINEL"
    resume=""   # intentional brand-new session
  fi
  CLAUDE_CMD="cd $WORKDIR && \
TELEGRAM_HTTP_PORT=$TELEGRAM_HTTP_PORT \
DISCORD_HTTP_PORT=$DISCORD_HTTP_PORT \
DISABLE_AUTOUPDATER=1 \
$CLAUDE_CMD_BASE \
$resume \
$extra"
}
# Default; build_claude_cmd will rebuild on every start.
build_claude_cmd

# ─── LOGGING ───────────────────────────────────────────────────────────────
LOG_DIR="$WORKDIR/logs"
LOG="$LOG_DIR/channel-bot-wrapper.log"
CRASH_DIR="$LOG_DIR/crashes"
CRASH_KEEP=10
MAX_FAILURES=3
CHECK_INTERVAL=30
STARTUP_WAIT=25

mkdir -p "$CRASH_DIR"

fail_count=0
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG"; }

# Capture tmux pane scrollback before killing — so claude's last words survive
# (handy for postmortem when claude crashes mid-task).
snapshot_pane() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then return; fi
  local crash_file="$CRASH_DIR/$(date '+%Y%m%d-%H%M%S').log"
  if tmux capture-pane -pt "$SESSION:0.0" -S -5000 > "$crash_file" 2>/dev/null; then
    log "captured pane scrollback to $crash_file"
    ls -t "$CRASH_DIR"/*.log 2>/dev/null | tail -n +"$((CRASH_KEEP + 1))" | xargs rm -f 2>/dev/null || true
  fi
}

start_claude() {
  snapshot_pane
  tmux kill-session -t "$SESSION" 2>/dev/null || true
  sleep 1
  build_claude_cmd  # consume any pending --resume args
  tmux new-session -d -s "$SESSION" -c "$WORKDIR"
  sleep 2
  tmux send-keys -t "$SESSION" "$CLAUDE_CMD" Enter
  log "sent claude command (workdir: $WORKDIR, TELEGRAM_HTTP_PORT=$TELEGRAM_HTTP_PORT), waiting ${STARTUP_WAIT}s..."
  sleep "$STARTUP_WAIT"

  # First-run trust prompt (idempotent — skipped on subsequent restarts).
  local pane_out
  pane_out=$(tmux capture-pane -pt "$SESSION:0.0" 2>/dev/null || echo "")
  if echo "$pane_out" | grep -q "trust this folder"; then
    log "trust prompt detected, confirming..."
    tmux send-keys -t "$SESSION" Enter
    sleep 10
  fi

  log "started $SESSION"
}

is_claude_alive() {
  # Check 1: tmux session exists
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    log "  check: session does not exist"
    return 1
  fi

  # Check 2: active pane is running claude (not a shell)
  local pane_cmd
  pane_cmd=$(tmux list-panes -t "$SESSION" -F '#{pane_current_command}' 2>/dev/null || echo "unknown")
  case "$pane_cmd" in
    zsh|bash|fish|sh|login)
      log "  check: pane running shell ($pane_cmd) = claude exited"
      return 1
      ;;
  esac

  # NB: we do NOT check whether the HTTP MCP daemon is reachable here.
  # The daemon is managed by its own launchd job (KeepAlive=true). If it
  # dies, launchd restarts it; if the network drops, claude's MCP transport
  # surfaces the error. Don't double-supervise.

  return 0
}

log "channel-bot wrapper starting, waiting 15s for network/launchd ordering..."
sleep 15
log "entering monitor loop (check every ${CHECK_INTERVAL}s, max ${MAX_FAILURES} consecutive failures before cooldown)"

while true; do
  if is_claude_alive; then
    if (( fail_count > 0 )); then
      log "claude recovered (was at attempt $fail_count)"
    fi
    fail_count=0
  else
    fail_count=$((fail_count + 1))
    if (( fail_count > MAX_FAILURES )); then
      log "COOLDOWN: $MAX_FAILURES consecutive failures, sleeping 1 hour before retry"
      log "Manual restart: tmux new-session -d -s $SESSION -c $WORKDIR && tmux send-keys -t $SESSION '$CLAUDE_CMD' Enter"
      sleep 3600
      fail_count=0
      log "cooldown over, resuming monitor"
      continue
    fi
    start_claude
    continue
  fi
  sleep "$CHECK_INTERVAL"
done
