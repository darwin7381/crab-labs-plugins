<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- telegram-bridge (WO-196 part B): one per machine; carries the bots of the agents named in ONSEN_BRIDGE (~/.config/crab-labs-plugins/env)
     between Telegram and Onsen's bridge interface. See README.md beside this file.
     Mac mini: sed -e "s#__HOME__#$HOME#g" -e "s#__MACHINE__#macmini#g" com.btai.telegram-bridge.plist.example > ~/Library/LaunchAgents/com.btai.telegram-bridge.plist
     MBP:      sed -e "s#__HOME__#$HOME#g" -e "s#__MACHINE__#mbp#g"     com.btai.telegram-bridge.plist.example > ~/Library/LaunchAgents/com.btai.telegram-bridge.plist
     The program runs from its own pinned checkout ~/.claude/telegram-bridge (not the live plugin checkout, so a fleet pull or wave never changes
     it); to update: git -C ~/.claude/telegram-bridge fetch origin && checkout --detach <commit>, then restart. ONSEN_BASE: the code's default
     unless set here. No bot token is in this file: each one is read from its agent's own .telegram-state/.env. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.btai.telegram-bridge</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.bun/bin/bun</string>
		<string>run</string>
		<string>__HOME__/.claude/telegram-bridge/plugins/telegram-http/telegram-bridge/telegram-bridge.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/.claude/telegram-bridge/plugins/telegram-http/telegram-bridge</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>TELEGRAM_BRIDGE_MACHINE</key>
		<string>__MACHINE__</string>
		<key>TELEGRAM_BRIDGE_CREDENTIAL_FILE</key>
		<string>__HOME__/.config/mesh/telegram-bridge-__MACHINE__.credential</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/telegram-bridge.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/telegram-bridge.err.log</string>
</dict>
</plist>
